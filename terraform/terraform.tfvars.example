aws_region   = "ap-southeast-1"
aws_profile  = "master-programmatic-admin"
project_name = "solar-system"
environment  = "dev"

cluster_name    = "solar-system-eks"
cluster_version = "1.33"

github_repository    = "aunghtetlwin-gh/Solar-system-cicd-eks"
github_deploy_branch = "main"

node_group_instance_types = ["t3.medium"]
node_group_min_size       = 1
node_group_desired_size   = 2
node_group_max_size       = 3

# For better security, replace this with your public IP CIDR, for example:
# cluster_endpoint_public_access_cidrs = ["203.0.113.10/32"]
cluster_endpoint_public_access_cidrs = ["0.0.0.0/0"]
